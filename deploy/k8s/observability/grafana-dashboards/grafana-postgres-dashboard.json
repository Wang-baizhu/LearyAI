      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(pg_up{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "PG 可用性",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(pg_database_size_bytes{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"})",
          "legendFormat": "db size",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "数据库体积",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(pg_stat_database_numbackends{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"})",
          "legendFormat": "connections",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "连接数",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "{{datname}} commit/s",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "{{datname}} rollback/s",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "事务速率",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(pg_stat_database_blks_hit{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"}[5m])), 1e-9)",
          "legendFormat": "cache hit",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "缓存命中率",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (datname) (rate(pg_stat_database_tup_fetched{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "{{datname}} tuples fetched/s",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (datname) (rate(pg_stat_database_tup_returned{job=~\"$job\",instance=~\"$instance\",datname=~\"$database\"}[5m]))",
          "legendFormat": "{{datname}} tuples returned/s",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "读取吞吐",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",

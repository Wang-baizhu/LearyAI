# 当前文件职责：tasks_server 服务专属环境变量示例（复制为 .env.task.local 后按实际环境修改）。

# ===== config（可放 ConfigMap） =====
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_STDOUT=1
LOG_FILE=logs/tasks_server.log

TASK_MQ_HOST=127.0.0.1
TASK_MQ_PORT=5672
TASK_MQ_USERNAME=admin
TASK_MQ_VHOST=/
TASK_MQ_EXCHANGE=task.exchange
TASK_MQ_AGENT_RUN_QUEUE=task.agent.run.queue
TASK_MQ_AGENT_RUN_ROUTING_KEY=task.command.agent.run
TASK_MQ_AGENT_RUN_RETRY_ROUTING_KEY=task.command.agent.run.retry
TASK_MQ_AGENT_RUN_MAX_RETRIES=3
TASK_MQ_STATUS_EVENT_ROUTING_KEY=task.event.status.changed

TASK_CWD=
TASK_AUTO_APPROVE=0
TASK_TOOL_CALL_MODE=error

USAGE_GRPC_HOST=localhost
USAGE_GRPC_PORT=9091

LEARY_STORE=rdb
KIMI_WIRE_SIMPLIFY_STORE=0
KIMI_PG_SLOW_MS=50
KIMI_PG_POOL_MIN_SIZE=2
KIMI_PG_POOL_MAX_SIZE=20
KIMI_AGENT_WS_TEST_MODE=0
KIMI_KB_BASE_URL=http://localhost:8001

TASK_FRONTEND_BASE_URL=http://localhost:8000

TASK_RUNTIME_MODE=normal
SERVER_API_BASE_URL=http://localhost:8080/api
SERVER_INTERNAL_SOURCE=leary-task

TASK_MQ_AGENT_RUN_PREFETCH_COUNT=50

# ===== secret（可放 Secret） =====
TASK_MQ_PASSWORD=your-mq-password
USAGE_GRPC_AK=your-usage-grpc-ak
LEARY_PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/learyai_test
SERVER_INTERNAL_TOKEN=your-server-internal-token

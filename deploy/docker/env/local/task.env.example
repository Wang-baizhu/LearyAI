# 当前文件职责：提供本地 Docker task 的环境变量示例，真实配置仅保留在本地。
TASK_MQ_ENABLED=1
TASK_MQ_HOST=rabbitmq
TASK_MQ_PORT=5672
TASK_MQ_USERNAME=admin
TASK_MQ_PASSWORD=replace-me
TASK_MQ_VHOST=bthost
TASK_MQ_EXCHANGE=task.exchange
TASK_MQ_AGENT_RUN_QUEUE=task.agent.run.queue
TASK_MQ_AGENT_RUN_ROUTING_KEY=task.command.agent.run
TASK_MQ_AGENT_RUN_RETRY_ROUTING_KEY=task.command.agent.run.retry
TASK_MQ_AGENT_RUN_MAX_RETRIES=3
TASK_MQ_STATUS_EVENT_ROUTING_KEY=task.event.status.changed
TASK_AUTO_APPROVE=0
TASK_TOOL_CALL_MODE=error
TASK_METRICS_ENABLED=1
LEARY_PG_DSN=postgresql://postgres:replace-me@postgres:5432/learyai_test
KIMI_PG_SLOW_MS=50
KIMI_PG_POOL_MIN_SIZE=2
KIMI_PG_POOL_MAX_SIZE=20
USAGE_GRPC_HOST=backend
USAGE_GRPC_PORT=9091
USAGE_GRPC_AK=replace-me
SERVER_API_BASE_URL=http://backend:8080/api
SERVER_INTERNAL_TOKEN=replace-me
SERVER_INTERNAL_SOURCE=leary-task
KIMI_KB_BASE_URL=http://host.docker.internal:8001

# 当前文件职责：提供本地 Docker backend 的环境变量示例，真实配置仅保留在本地。
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/learyai_test
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-me
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-me
SPRING_DATA_REDIS_TIMEOUT=5s
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=admin
SPRING_RABBITMQ_PASSWORD=replace-me
SPRING_RABBITMQ_VIRTUAL_HOST=bthost
AUTH_INTERNAL_ENABLED=true
AUTH_INTERNAL_TOKEN=replace-me
AUTH_INTERNAL_SOURCE_WHITELIST=local-dev,leary-agent,leary-task
USAGE_SERVICE_GRPC_PORT=9091
USAGE_SERVICE_AK=replace-me
KB_STORAGE_MINIO_ACCESS_KEY=replace-me
KB_STORAGE_MINIO_SECRET_KEY=replace-me

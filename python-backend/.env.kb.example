# 当前文件职责：kb_server 服务专属环境变量示例（复制为 .env.kb.local 后按实际环境修改）。

# ===== config（可放 ConfigMap） =====
KB_STORAGE_PROVIDER=minio

KIMI_KB_HOST=0.0.0.0
KIMI_KB_PORT=8001
KIMI_KB_MQ_ENABLED=1

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_STDOUT=1
LOG_FILE=logs/kb_server.log

KB_STORAGE_MINIO_ENDPOINT=http://127.0.0.1:9000
KB_STORAGE_MINIO_BUCKET=learyai

KB_SOFFICE_PATH=/opt/libreoffice/program/soffice

KB_MQ_HOST=localhost
KB_MQ_PORT=5672
KB_MQ_USERNAME=admin
KB_MQ_VHOST=/
KB_MQ_DOC_TASK_EXCHANGE=kb.doc.task.exchange
KB_MQ_DOC_TASK_QUEUE=kb.doc.task.queue
KB_MQ_DOC_TASK_ROUTING_KEY=kb.doc.task

TASK_MQ_EXCHANGE=task.exchange
TASK_MQ_DOC_QUEUE=task.doc.queue
TASK_MQ_DOC_ROUTING_KEY=task.doc
TASK_MQ_STATUS_ROUTING_KEY=task.status

# 集成测试开关：
# - KIMI_KB_IT_ENABLED=1 后，tests/kb_server/test_rag_integration.py 会从本文件读取配置。
# - KIMI_KB_IT_DOC_ID 需要填写真实存在的 doc_id；为空时真实 URL 测试仍会 skip。
# - KIMI_KB_IT_MUTATION_ENABLED 默认关闭，避免误改线上/共享环境数据。
KIMI_KB_IT_ENABLED=0
KIMI_KB_IT_BASE_URL=http://127.0.0.1:8001
KIMI_KB_IT_TIMEOUT=10
KIMI_KB_IT_DOC_ID=
KIMI_KB_IT_MUTATION_ENABLED=0
KB_RUN_URL_INTEGRATION_TESTS=0
KIMI_KB_DOC_CLEAR_IT_ENABLED=0

# ===== secret（可放 Secret） =====
KB_PG_DSN=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/learyai_test
KB_STORAGE_MINIO_ACCESS_KEY=your-minio-access-key
KB_STORAGE_MINIO_SECRET_KEY=your-minio-secret-key
KB_STORAGE_OSS_ACCESS_KEY_ID=your-oss-access-key-id
KB_STORAGE_OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
KB_MQ_PASSWORD=your-mq-password
# B 站完整 Cookie，供 URL 字幕提取优先使用登录态获取字幕；不需要时可留空
KB_BILIBILI_COOKIE=

# 当前文件职责：提供 prod 环境 agent_ws 的非敏感环境变量（供 kustomize configMapGenerator 加载）。
KIMI_AGENT_WS_HOST=127.0.0.1
KIMI_AGENT_WS_PORT=8081
KIMI_AGENT_WS_CWD=./
KIMI_RDB_WORK_DIR_BASE=/app/workdir/learyai

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_STDOUT=1
LOG_FILE=

AUTH_REDIS_HOST=leary-redis
AUTH_REDIS_PORT=6379
AUTH_REDIS_DB=0
AUTH_REDIS_TIMEOUT=5

LEARY_STORE=rdb
KIMI_WIRE_SIMPLIFY_STORE=0
KIMI_PG_SLOW_MS=200
KIMI_PG_POOL_MIN_SIZE=2
KIMI_PG_POOL_MAX_SIZE=20
KIMI_AGENT_WS_TEST_MODE=0

USAGE_GRPC_HOST=leary-backend
USAGE_GRPC_PORT=9091

SERVER_API_BASE_URL=http://leary-backend:8080/api
SERVER_INTERNAL_SOURCE=leary-agent
SESSION_CONTEXT_TTL_SECONDS=360000

KIMI_DEBUGPY=0
KIMI_DEBUGPY_HOST=127.0.0.1
KIMI_DEBUGPY_PORT=5678

KIMI_CLI_NO_AUTO_UPDATE=0

KIMI_KB_BASE_URL=http://10.0.8.10:8001
TASK_MQ_STATUS_ROUTING_KEY=task.status

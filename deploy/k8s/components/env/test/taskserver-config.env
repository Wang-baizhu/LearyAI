# 当前文件职责：提供 test 环境 tasks_server 的非敏感环境变量（供 kustomize configMapGenerator 加载）。
TASK_MQ_ENABLED=1
TASK_MQ_HOST=leary-rabbitmq
TASK_MQ_PORT=5672
TASK_MQ_USERNAME=admin
TASK_MQ_VHOST=bthost
TASK_MQ_EXCHANGE=task.exchange
TASK_MQ_AGENT_RUN_QUEUE=task.agent.run.queue
TASK_MQ_AGENT_RUN_ROUTING_KEY=task.command.agent.run
TASK_MQ_STATUS_EVENT_ROUTING_KEY=task.event.status.changed
KB_MQ_DOC_TASK_ROUTING_KEY=kb.doc.task

TASK_CWD=/app
KIMI_TASK_CWD=/app
TASK_AUTO_APPROVE=0
TASK_TOOL_CALL_MODE=error
KIMI_PG_SLOW_MS=200
KIMI_PG_POOL_MIN_SIZE=2
KIMI_PG_POOL_MAX_SIZE=20

TASK_METRICS_ENABLED=1
TASK_METRICS_HOST=0.0.0.0
TASK_METRICS_PORT=8023

USAGE_GRPC_HOST=leary-backend
USAGE_GRPC_PORT=9091

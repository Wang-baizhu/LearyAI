      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\",env=~\"$env\",instance=~\"$instance\",status=~\"5..\",uri!~\"/actuator.*\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=~\"$job\",env=~\"$env\",instance=~\"$instance\",uri!~\"/actuator.*\"}[5m])), 1e-9)",
          "legendFormat": "5xx错误率",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx 错误率",
      "type": "timeseries"

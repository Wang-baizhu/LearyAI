# 当前文件职责：提供本地 Docker agent 的环境变量示例，真实配置仅保留在本地。
KIMI_AGENT_WS_TEST_MODE=0
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_STDOUT=1
AUTH_REDIS_HOST=redis
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=replace-me
AUTH_REDIS_DB=0
AUTH_REDIS_TIMEOUT=5
LEARY_PG_DSN=postgresql://postgres:replace-me@postgres:5432/learyai_test
KIMI_PG_SLOW_MS=50
KIMI_PG_POOL_MIN_SIZE=2
KIMI_PG_POOL_MAX_SIZE=20
USAGE_GRPC_HOST=backend
USAGE_GRPC_PORT=9091
USAGE_GRPC_AK=replace-me
SERVER_API_BASE_URL=http://backend:8080/api
SERVER_INTERNAL_TOKEN=replace-me
SERVER_INTERNAL_SOURCE=leary-agent
KIMI_KB_BASE_URL=http://host.docker.internal:8001

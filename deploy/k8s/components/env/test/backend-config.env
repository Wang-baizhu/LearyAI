# 当前文件职责：提供 test 环境 Java backend 的非敏感环境变量（供 kustomize configMapGenerator 加载）。
SPRING_APPLICATION_NAME=learyAI
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true
MANAGEMENT_METRICS_TAGS_APPLICATION=learyAI
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB_SERVLET_DISPATCHERSERVLET=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8000,http://192.168.31.160:8000

SPRING_DATASOURCE_URL=jdbc:postgresql://leary-postgres:5432/learyai_test
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_OPEN_IN_VIEW=false

SPRING_DATA_REDIS_HOST=leary-redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=5s

SPRING_RABBITMQ_HOST=leary-rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=admin
SPRING_RABBITMQ_VIRTUAL_HOST=bthost

AUTH_SESSION_TTL_SECONDS=86400
AUTH_SESSION_REMEMBER_ME_TTL_SECONDS=604800
AUTH_SESSION_RENEW_THRESHOLD_SECONDS=1800
AUTH_SESSION_TEST_BYPASS_ENABLED=true
AUTH_SESSION_TEST_BYPASS_SESSION_ID=test
AUTH_SESSION_TEST_BYPASS_USER_ID=1
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_COOKIE_NAME=sessionId
AUTH_COOKIE_SAME_SITE=Lax
AUTH_TOKEN_TTL_SECONDS=1800
AUTH_TOKEN_REFRESH_THRESHOLD_SECONDS=30
AUTH_TOKEN_TEST_BYPASS_ENABLED=true
AUTH_TOKEN_TEST_BYPASS_TOKEN_VALUE=test-token
AUTH_TOKEN_TEST_BYPASS_USER_ID=1
AUTH_TOKEN_TEST_BYPASS_SESSION_ID=test
AUTH_INTERNAL_ENABLED=true
AUTH_INTERNAL_HEADER_NAME=X-Internal-Token
USAGE_SERVICE_GRPC_PORT=9091
AUTH_SMS_CODE_LENGTH=6
AUTH_SMS_CODE_TTL_SECONDS=300
AUTH_SMS_RESEND_INTERVAL_SECONDS=60
AUTH_SMS_LIMIT_WINDOW_SECONDS=600
AUTH_SMS_MAX_PER_WINDOW=3
AUTH_SMS_ALIYUN_TEMPLATE_CODE=100001
AUTH_SMS_ALIYUN_REGION=cn-shenzhen
AUTH_SMS_ALIYUN_ENDPOINT=dypnsapi.aliyuncs.com

KB_STORAGE_PROVIDER=oss
KB_STORAGE_MINIO_ENDPOINT=http://192.168.31.160:9000
KB_STORAGE_MINIO_BUCKET=learyai
KB_STORAGE_MINIO_PRESIGN_EXPIRE_SECONDS=3600
KB_STORAGE_MINIO_REGION=
KB_STORAGE_MINIO_STS_ROLE_ARN=
KB_STORAGE_MINIO_STS_ROLE_SESSION_NAME=kb-docs
KB_STORAGE_MINIO_STS_EXTERNAL_ID=
KB_STORAGE_STS_EXPIRE_SECONDS=3600

KB_STORAGE_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
KB_STORAGE_OSS_BUCKET=learyai
KB_STORAGE_OSS_REGION=cn-shenzhen
KB_STORAGE_OSS_PRESIGN_EXPIRE_SECONDS=3600
KB_STORAGE_OSS_ROLE_ARN=acs:ram::1074909886452249:role/learyai-oss
KB_STORAGE_OSS_ROLE_SESSION_NAME=kb-docs
KB_STORAGE_OSS_EXTERNAL_ID=
KB_STORAGE_OSS_STS_ENDPOINT=sts.aliyuncs.com

TASK_MQ_EXCHANGE=task.exchange
TASK_MQ_ROUTING_KEY=task
USAGE_IDEMPOTENCY_REDIS_TTL_SECONDS=300
USAGE_SNAPSHOT_REDIS_EXTRA_TTL_SECONDS=3600

CACHE_COMMON_ENABLED=true
CACHE_COMMON_JITTER_PERCENT=20
CACHE_COMMON_NULL_TTL_SECONDS=20
CACHE_COMMON_SECOND_DELETE_ENABLED=true
CACHE_COMMON_SECOND_DELETE_DELAY_MILLIS=300

CACHE_AUTH_ENABLED=true
CACHE_AUTH_ME_TTL_SECONDS=60
CACHE_AUTH_ME_NULL_TTL_SECONDS=20

CACHE_AUTHZ_ENABLED=true
CACHE_AUTHZ_ROLE_TTL_SECONDS=60
CACHE_AUTHZ_PROJECT_EXISTS_TTL_SECONDS=120
CACHE_AUTHZ_ROLE_NULL_TTL_SECONDS=20
CACHE_AUTHZ_PROJECT_EXISTS_NULL_TTL_SECONDS=20

CACHE_TEMPLATE_ENABLED=true
CACHE_TEMPLATE_LIST_TTL_SECONDS=120
CACHE_TEMPLATE_DETAIL_TTL_SECONDS=120
CACHE_TEMPLATE_DATA_TTL_SECONDS=60
CACHE_TEMPLATE_DATA_NULL_TTL_SECONDS=20

CACHE_KB_ENABLED=true
CACHE_KB_LIST_TTL_SECONDS=120
CACHE_KB_RECENT_TTL_SECONDS=60
CACHE_KB_DETAIL_TTL_SECONDS=60

CACHE_KBDOC_ENABLED=true
CACHE_KBDOC_LIST_TTL_SECONDS=60
CACHE_KBDOC_DETAIL_TTL_SECONDS=60
CACHE_KBDOC_CHUNKS_TTL_SECONDS=180
CACHE_KBDOC_RECENT_TTL_SECONDS=60

AUTH_INTERNAL_SOURCE_HEADER_NAME=X-Internal-Source
AUTH_INTERNAL_SOURCE_WHITELIST=leary-agent,leary-task
LEARY_TEMPLATE_PREVIEW_BASE_URL=http://localhost:7999

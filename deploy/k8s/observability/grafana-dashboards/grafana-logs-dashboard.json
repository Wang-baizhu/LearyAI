      "targets": [
        {
          "editorMode": "code",
          "expr": "{namespace=\"$namespace\",app=~\"$app\",pod=~\"$pod\"} |~ \"(?i)$level\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "日志流（按命名空间/服务/Pod/等级）",
      "type": "logs"

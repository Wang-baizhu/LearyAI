# 当前文件职责：agent_ws 本地环境变量示例（复制为 .env.agent.local 后按实际环境修改）。

# LEARY_USER_ID=
# LEARY_KB_ID=

# ===== config（可放 ConfigMap） =====
KIMI_AGENT_WS_HOST=0.0.0.0
KIMI_AGENT_WS_PORT=8081
# 配置KIMI_RDB_WORK_DIR_BASE会覆盖KIMI_AGENT_WS_CWD
KIMI_AGENT_WS_CWD=./
KIMI_RDB_WORK_DIR_BASE=/app/workdir/learyai

USAGE_GRPC_HOST=localhost
USAGE_GRPC_PORT=9091

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_STDOUT=1
LOG_FILE=logs/agent_ws.log

AUTH_REDIS_HOST=127.0.0.1
AUTH_REDIS_PORT=6379
AUTH_REDIS_DB=0
AUTH_REDIS_TIMEOUT=5

LEARY_STORE=rdb
KIMI_WIRE_SIMPLIFY_STORE=0
KIMI_PG_SLOW_MS=50

KIMI_KB_BASE_URL=http://localhost:8001

KIMI_DEBUGPY=0
KIMI_DEBUGPY_HOST=127.0.0.1
KIMI_DEBUGPY_PORT=5678
KIMI_CLI_NO_AUTO_UPDATE=1

SERVER_API_BASE_URL=http://localhost:8080/api
SESSION_CONTEXT_TTL_SECONDS=360000

KIMI_BACKGROUND_ENABLED=1

# 是否开启全量拉取历史context
KIMI_AGENT_WS_CONTEXT_LATEST_FULL=0

KIMI_TURN_MODE=normal
KIMI_TURN_RECORD_ROOT=./python-backend

KIMI_PG_POOL_MIN_SIZE=2
KIMI_PG_POOL_MAX_SIZE=20

# ===== secret（可放 Secret） =====
USAGE_GRPC_AK=your-usage-grpc-ak
AUTH_REDIS_PASSWORD=your-redis-password
LEARY_PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/learyai_test
SERVER_INTERNAL_TOKEN=your-server-internal-token

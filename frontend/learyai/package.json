{
  "name": "learyai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "cap:sync": "bash scripts/capacitor/sync.sh",
    "cap:run:android": "bash scripts/capacitor/run-android.sh",
    "cap:run:ios": "bash scripts/capacitor/run-ios.sh",
    "gen:backend-types": "bash ../../scripts/schema/gen_backend_schema_from_backend.sh",
    "lint:arch": "leary-arch-check",
    "lint:arch:fsd": "leary-arch-check --profile=generic-fsd",
    "lint": "pnpm run lint:arch && eslint . && tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test:arch-check": "vitest run --config packages/common/arch-check/vitest.config.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "TMPDIR=/tmp TMP=/tmp TEMP=/tmp vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@capacitor/app": "^7.1.1",
    "@capacitor/browser": "^7.0.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dtjv/sm-2": "^2.1.0",
    "@leary/intro-animation": "workspace:*",
    "@leary/template-plugin-sdk-core": "workspace:*",
    "@leary/template-plugin-sdk-host": "workspace:*",
    "@leary/template-plugin-sdk-react": "workspace:*",
    "@leary/template-ppt-runtime": "workspace:*",
    "@leary/text-editable": "workspace:*",
    "@leary/tour-guide": "workspace:*",
    "@leary/ui": "workspace:*",
    "@reduxjs/toolkit": "^2.11.2",
    "@streamdown/math": "^1.0.2",
    "@tanstack/react-query": "^5.59.0",
    "@xyflow/react": "^12.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ali-oss": "^6.22.0",
    "axios": "^1.7.6",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.564.0",
    "mdast-util-to-markdown": "^2.1.2",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.2",
    "react-use-websocket": "^4.13.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "^5.3.2",
    "unified": "11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.1.12",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@eslint/js": "^9.39.1",
    "@leary/arch-check": "workspace:*",
    "@leary/eslint-config": "workspace:*",
    "@types/d3": "^7.4.3",
    "@types/d3-shape": "^3.1.8",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
